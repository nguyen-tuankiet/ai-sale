# Chỉ chứa TÊN biến và giá trị mẫu. Đặt giá trị thật trong Vercel → Settings → Environment Variables (loại Secret cho khóa/mật khẩu). Không commit .env thật.

# ---- Giá và thanh toán (SePay) ----
SITE_URL=https://your-sales-site.example.com
PRICE_VND=50000
PRICE_PRO_VND=99000
DOWNLOAD_LIMIT=5
BANK_NAME=BIDV
BANK_ACCOUNT=your-sepay-account-or-va
BANK_HOLDER=NGUYEN VAN A
SEPAY_API_KEY=replace-with-long-random-string

# ---- Kho dữ liệu (Upstash Redis, có gói miễn phí) ----
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# ---- Giao file (repo GitHub riêng tư chứa muse-studio.zip và muse-studio-pro.zip) ----
RELEASE_REPO=your-github-name/muse-studio-release
GITHUB_TOKEN=replace-with-read-only-fine-grained-token

# ---- Quản trị ----
ADMIN_PASSWORD=replace-with-long-password
ADMIN_SECRET=replace-with-another-random-string

# ---- Sổ công khai ----
GOAL_VND=500000
START_DATE=2026-10-22
DEADLINE_DATE=2026-11-21
# Đơn nhỏ hơn mức này coi là đơn thử, không vào sổ công khai
LEDGER_MIN_VND=20000

# ---- Email giao hàng (tùy chọn) ----
SUPPORT_EMAIL=support@example.com
# RESEND_API_KEY=replace-me
# MAIL_FROM=Muse Studio <no-reply@your-domain.example>
