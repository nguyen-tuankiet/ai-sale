# Chỉ chứa TÊN biến và giá trị mẫu. Đặt giá trị thật trong Vercel → Settings → Environment Variables (loại Secret). Không commit .env thật.

# Trang bán hàng hiện có của bạn (nơi khách mua). Mọi bài quảng bá dẫn về đây kèm UTM.
LANDING_URL=https://your-landing-site.example.com

# Kho dữ liệu (Upstash Redis, có gói miễn phí)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Mật khẩu /admin/ của TRANG BÁN (để Analytics Agent đọc số liệu; chỉ đọc). Bỏ trống nếu không dùng Analytics.
LANDING_ADMIN_PASSWORD=replace-with-landing-admin-password

# Quản trị
ADMIN_PASSWORD=replace-with-long-password
ADMIN_SECRET=replace-with-another-random-string

# Worker trên máy bạn dùng khóa này để nhận việc (≥ 16 ký tự, ngẫu nhiên, khác ADMIN_PASSWORD)
WORKER_TOKEN=replace-with-long-random-string

# ---- Chỉ đặt trên MÁY BẠN khi chạy worker (không đặt trên Vercel) ----
# API_BASE=https://your-sales-console.vercel.app
# MUSE_STUDIO_DIR=../museinsight
# POLL_SECONDS=60
# MUSE_HEADLESS=1
